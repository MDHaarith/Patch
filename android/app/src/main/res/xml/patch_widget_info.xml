<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3 by default (minWidth/minHeight is the default size on launchers
     before API 31), down to 2x2. The 30-minute update only re-renders the
     last snapshot Rust stored, so the header's date rolls over. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_preview_image"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
