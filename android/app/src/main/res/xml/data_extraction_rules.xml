<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks sync through the user's own hub; keep the pairing token off cloud backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
