<?xml version="1.0" encoding="utf-8"?>
<!-- A list row's tile. List items can't have margins, so the gap below the
     row is an inset (rows add it to their bottom padding). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetBottom="4dp">
    <shape android:shape="rectangle">
        <corners android:radius="10dp" />
        <solid android:color="@color/widget_row" />
    </shape>
</inset>
