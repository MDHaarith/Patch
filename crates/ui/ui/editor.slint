import { Theme } from "theme.slint";
import { Icon, IconBox } from "icons.slint";
import { Store, Editor, Actions } from "store.slint";
import { Surface, Field, Toggle, Check, Segmented, IconButton, Button, Scroll, SectionLabel, Divider, PageHeader } from "widgets.slint";
import { RangePicker } from "calendar-bits.slint";

// A compact dropdown: the current choice, expanding into a list in place.
export component Picker inherits VerticalLayout {
    in property <string> label;
    in property <string> icon;
    in property <[string]> options;
    in property <int> current;
    callback picked(int);
    property <bool> open;
    spacing: 4px;
    Rectangle {
        height: Store.mobile ? 44px : 34px;
        border-radius: 10px;
        background: head.pressed ? Theme.press : Theme.well;
        border-width: 1px;
        border-color: root.open ? Theme.accent.with-alpha(0.6) : Theme.hairline;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            IconBox { name: root.icon; size: 13px; tint: Theme.text-2; }
            Text { text: root.label; color: Theme.text-2; font-size: Theme.fs-m; vertical-alignment: center; }
            Text {
                horizontal-stretch: 1;
                horizontal-alignment: right;
                overflow: elide;
                text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : "";
                color: Theme.text;
                font-size: Theme.fs-m;
                font-weight: 600;
                vertical-alignment: center;
            }
            IconBox { name: root.open ? "chevron-up" : "chevron-down"; size: 12px; tint: Theme.text-2; }
        }
        head := TouchArea { clicked => { root.open = !root.open; } }
    }
    if root.open: Rectangle {
        height: list.preferred-height;
        border-radius: 12px;
        background: Theme.float;
        border-width: 1px;
        border-color: Theme.hairline;
        list := VerticalLayout {
            padding: 4px;
            for o[i] in root.options: Rectangle {
                height: Store.mobile ? 42px : 32px;
                border-radius: 8px;
                background: i == root.current ? Theme.accent-soft : ota.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: o;
                        color: i == root.current ? Theme.accent : Theme.text;
                        font-size: Theme.fs-m;
                        font-weight: i == root.current ? 600 : 400;
                        vertical-alignment: center;
                    }
                    if i == root.current: IconBox { name: "check"; size: 12px; tint: Theme.accent; }
                }
                ota := TouchArea {
                    clicked => {
                        root.picked(i);
                        root.open = false;
                    }
                }
            }
        }
    }
}

component Group inherits VerticalLayout {
    in property <string> title;
    in property <string> icon;
    spacing: 8px;
    HorizontalLayout {
        spacing: 6px;
        if root.icon != "": IconBox { name: root.icon; size: 12px; tint: Theme.text-2; }
        SectionLabel { text: root.title; }
    }
    @children
}

export component EditorPanel inherits Rectangle {
    property <bool> choosing-blockers;
    callback close();
    VerticalLayout {
        PageHeader {
            title: Editor.is-new ? "New task" : "Task";
            leading-icon: "close";
            action-text: Editor.is-new ? "Add" : "Done";
            action-enabled: Editor.title != "";
            back => { Actions.editor-close(); }
            action => { Actions.editor-save(); }
        }
        Divider {}
        scroll := Scroll {
            vertical-stretch: 1;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: scroll.width;
                alignment: start;
                padding: 16px;
                padding-bottom: 40px;
                spacing: 18px;

                title-field := Field {
                    text <=> Editor.title;
                    placeholder: "What needs doing?";
                    font-size: 18px * Theme.text-scale;
                    font-weight: 600;
                    init => {
                        if (Editor.is-new && !Store.mobile) {
                            self.focus-input();
                        }
                    }
                    accepted => { Actions.editor-save(); }
                }

                Group {
                    title: "LIST";
                    Segmented {
                        choices: Editor.lists;
                        current: Editor.list-index;
                        columns: 2;
                        picked(i) => { Editor.list-index = i; }
                    }
                }

                Group {
                    title: "STATUS";
                    Segmented {
                        choices: Editor.columns;
                        current: Editor.column-index;
                        columns: 3;
                        picked(i) => { Editor.column-index = i; }
                    }
                }

                Group {
                    title: "PRIORITY";
                    Segmented {
                        items: ["None", "Low", "Medium", "High"];
                        current: Editor.priority;
                        stretch: true;
                        picked(i) => { Editor.priority = i; }
                    }
                }

                Group {
                    title: "SCHEDULE";
                    icon: "calendar";
                    HorizontalLayout {
                        Text { text: "Date & time"; color: Theme.text; font-size: Theme.fs-m; vertical-alignment: center; horizontal-stretch: 1; }
                        Toggle {
                            checked <=> Editor.scheduled;
                            toggled => { Actions.editor-changed(); }
                        }
                    }
                    if Editor.scheduled: HorizontalLayout {
                        Text { text: "All-day"; color: Theme.text; font-size: Theme.fs-m; vertical-alignment: center; horizontal-stretch: 1; }
                        Toggle {
                            checked <=> Editor.all-day;
                            toggled => { Actions.editor-changed(); }
                        }
                    }
                    if Editor.scheduled: RangePicker {
                        confirmed => { Actions.editor-changed(); }
                    }
                    if Editor.scheduled: Text {
                        text: Editor.range-label;
                        color: Theme.text-2;
                        font-size: Theme.fs-s;
                        wrap: word-wrap;
                    }
                }

                if Editor.scheduled: Picker {
                    label: "Repeat";
                    icon: "repeat";
                    options: Editor.repeats;
                    current: Editor.repeat-index;
                    picked(i) => { Editor.repeat-index = i; }
                }

                if Editor.scheduled && Editor.repeat-index > 0 && !Editor.is-new: Button {
                    text: "Skip this occurrence";
                    clicked => { Actions.skip-occurrence(); }
                }

                if Editor.scheduled: Picker {
                    label: "Alert";
                    icon: "bell";
                    options: Editor.reminders;
                    current: Editor.reminder-index;
                    picked(i) => { Editor.reminder-index = i; }
                }

                Group {
                    title: "TAGS";
                    Field { text <=> Editor.tags; placeholder: "Tags, separated by spaces"; }
                }

                if Editor.scheduled: Group {
                    title: "ADDITIONAL ALERTS";
                    Field { text <=> Editor.extra-reminders; placeholder: "Minutes before: 5, 60, 1440"; }
                }

                Group {
                    title: "SUBTASKS & DEPENDENCIES";
                    Text { text: Editor.link-status; color: Theme.text-2; font-size: Theme.fs-s; }
                    Picker {
                        label: "Parent";
                        options: Editor.parent-options;
                        current: Editor.parent-index;
                        picked(i) => { Editor.parent-index = i; }
                    }
                    for child in Editor.children: Button { text: (child.done ? "✓ " : "○ ") + child.text; clicked => { Actions.open-task(child.id); } }
                    SectionLabel { text: "BLOCKED BY"; }
                    Button { text: root.choosing-blockers ? "Done choosing blockers" : "Choose blockers"; clicked => { root.choosing-blockers = !root.choosing-blockers; } }
                    VerticalLayout {
                        spacing: 0px;
                        for task in Editor.blocker-options: Rectangle {
                            height: root.choosing-blockers || task.done ? (Store.mobile ? 40px : 30px) : 0px;
                            visible: root.choosing-blockers || task.done;
                            HorizontalLayout {
                                spacing: 8px;
                                Check { checked: task.done; toggled => { Actions.blocker-toggle(task.id); } }
                                Text { text: task.text; color: Theme.text; font-size: Theme.fs-m; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                    }
                }

                Group {
                    title: "CHECKLIST";
                    icon: "checklist";
                    for row[i] in Editor.checklist: HorizontalLayout {
                        spacing: 10px;
                        height: Store.mobile ? 40px : 30px;
                        Check {
                            y: (parent.height - self.height) / 2;
                            checked: row.done;
                            size: 16px;
                            toggled => { Actions.check-toggle(i); }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: row.text;
                            color: row.done ? Theme.text-3 : Theme.text;
                            font-size: Theme.fs-m;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "close";
                            size: 22px;
                            icon-size: 11px;
                            clicked => { Actions.check-remove(i); }
                        }
                    }
                    Field {
                        icon: "plus";
                        placeholder: "Add an item";
                        accepted(t) => {
                            if (t != "") {
                                Actions.check-add(t);
                            }
                            self.text = "";
                        }
                    }
                }

                Group {
                    title: "NOTES";
                    icon: "note";
                    Field {
                        text <=> Editor.notes;
                        multiline: true;
                        min-height: 96px;
                        placeholder: "Notes, links, details…";
                        edited(text) => { Actions.notes-edited(text); }
                    }
                    // Not a Button: those grow to fit their text, and URLs get long.
                    for link in Editor.links: Rectangle {
                        height: Store.mobile ? 40px : 30px;
                        border-radius: 6px;
                        background: link-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: link;
                        accessible-action-default => { Actions.open-link(link); }
                        HorizontalLayout {
                            spacing: 8px;
                            Icon { y: (parent.height - self.height) / 2; name: "open"; size: 14px; tint: Theme.accent; }
                            Text { text: link; color: Theme.accent; font-size: Theme.fs-m; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        link-touch := TouchArea { clicked => { Actions.open-link(link); } }
                    }
                }

                HorizontalLayout {
                    Text { text: "Use as template"; color: Theme.text; font-size: Theme.fs-m; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked <=> Editor.template; }
                }
                if !Editor.is-new && (Editor.archived || Editor.done): HorizontalLayout {
                    Text { text: Editor.archived ? "Archived" : "Archive completed task"; color: Theme.text; font-size: Theme.fs-m; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked <=> Editor.archived; }
                }
                if !Editor.is-new && !Editor.done && !Editor.template: HorizontalLayout {
                    spacing: 8px;
                    Button { horizontal-stretch: 1; text: "Focus 25 min"; clicked => { Actions.focus-start(25); } }
                    Button { horizontal-stretch: 1; text: "Focus 50 min"; clicked => { Actions.focus-start(50); } }
                }
                if !Editor.is-new: Button {
                    text: Editor.template ? "Create task from template" : "Duplicate task";
                    clicked => { Actions.duplicate-task(); }
                }
                if !Editor.is-new: Button {
                    text: "Delete task";
                    icon: "trash";
                    kind: 2;
                    clicked => { Actions.editor-delete(); }
                }
            }
        }
    }
}
