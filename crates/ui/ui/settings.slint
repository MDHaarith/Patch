import { Theme, Look } from "theme.slint";
import { Icon, IconBox } from "icons.slint";
import { Store, Actions } from "store.slint";
import { Glass, Field, Toggle, IconButton, Button, Scroll, SectionLabel, Divider } from "widgets.slint";

// A miniature of the reference picker in each look.
component LookCard inherits Rectangle {
    in property <int> look;
    in property <string> label;
    in property <bool> selected;
    callback picked();
    property <brush> bg: look == 0 ? @linear-gradient(180deg, #0d0d0f 0%, #050506 100%) : look == 1 ? @linear-gradient(160deg, #4b8d88 0%, #154a5d 100%) : @linear-gradient(180deg, #f2f2f6 0%, #e4e4ea 100%);
    property <color> card: look == 0 ? #1c1c1e : look == 1 ? #ffffff2e : #ffffff;
    property <color> ink: look == 2 ? #1d1d1f : #f5f5f7;
    property <color> band: look == 0 ? #3a3a3d : look == 1 ? #ffffff40 : #e3e3e8;
    height: 128px;
    border-radius: 16px;
    background: bg;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.hairline;
    Rectangle {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: 78px;
        border-radius: 14px;
        background: root.card;
        border-width: 1px;
        border-color: root.look == 2 ? #0000000f : #ffffff26;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000040;
        Text { x: 9px; y: 7px; text: "October 2026"; color: root.ink; font-size: 9px; font-weight: 700; }
        for r in 3: Rectangle {
            y: 24px + r * 16px;
            height: 14px;
            for c in 7: Rectangle {
                property <int> d: r * 7 + c + 5;
                x: 6px + c * (parent.width - 12px) / 7;
                width: (parent.width - 12px) / 7;
                if d == 14: Rectangle { background: root.band; height: 12px; }
                if d == 13: Rectangle { x: parent.width / 2; width: parent.width / 2; background: root.band; height: 12px; }
                if d == 15: Rectangle { width: parent.width / 2; background: root.band; height: 12px; }
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: d == 13 || d == 15 ? #0a84ff : transparent;
                    Text { text: d; font-size: 7px; color: d == 13 || d == 15 ? #ffffff : root.ink; }
                }
            }
        }
    }
    Text {
        y: parent.height - 30px;
        width: parent.width;
        text: root.label;
        horizontal-alignment: center;
        font-size: Theme.fs-m;
        font-weight: 600;
        color: root.ink;
    }
    TouchArea { clicked => { root.picked(); } }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 12px;
    min-height: Store.mobile ? 48px : 36px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: Theme.fs-m; font-weight: 500; }
        if root.hint != "": Text { text: root.hint; color: Theme.text-2; font-size: Theme.fs-s; wrap: word-wrap; }
    }
    @children
}

component Card inherits Glass {
    in property <string> title;
    in property <string> icon;
    fill: Theme.light ? #ffffff : Theme.glass ? #ffffff17 : #141416;
    sheen: !Theme.matte;
    radius: 16px;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            if root.icon != "": IconBox { name: root.icon; size: 14px; tint: Theme.accent; }
            Text { text: root.title; font-size: Theme.fs-l; font-weight: 700; color: Theme.text; }
        }
        @children
    }
}

export component SettingsPanel inherits Rectangle {
    property <string> url-input: Store.hub-url;
    property <string> token-input: Store.hub-token;
    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-left: 18px;
            height: Store.mobile ? 60px : 52px;
            Text {
                horizontal-stretch: 1;
                text: "Settings";
                font-size: Theme.fs-xl;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: "close";
                clicked => { Store.settings-open = false; }
            }
        }
        scroll := Scroll {
            vertical-stretch: 1;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: scroll.width;
                alignment: start;
                padding: 16px;
                padding-top: 4px;
                padding-bottom: 40px;
                spacing: 14px;

                Card {
                    title: "Appearance";
                    icon: "layers";
                    HorizontalLayout {
                        spacing: 10px;
                        LookCard { horizontal-stretch: 1; look: 0; label: "Matte Black"; selected: Theme.look == Look.matte; picked => { Actions.set-look(0); } }
                        LookCard { horizontal-stretch: 1; look: 1; label: "Liquid Glass"; selected: Theme.look == Look.glass; picked => { Actions.set-look(1); } }
                        LookCard { horizontal-stretch: 1; look: 2; label: "Light"; selected: Theme.look == Look.light; picked => { Actions.set-look(2); } }
                    }
                    Row {
                        label: "Week starts on Monday";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.week-monday; toggled(v) => { Actions.set-week-monday(v); } }
                    }
                    Row {
                        label: "24-hour time";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.time-24h; toggled(v) => { Actions.set-time-24h(v); } }
                    }
                }

                Card {
                    title: "Sync over Tailscale";
                    icon: "sync";
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Store.sync-state == 2 ? Theme.success : Store.sync-state == 1 ? Theme.warning : Store.sync-state == 0 ? Theme.text-3 : Theme.danger;
                        }
                        Text { horizontal-stretch: 1; text: Store.sync-label; color: Theme.text-2; font-size: Theme.fs-s; wrap: word-wrap; }
                    }

                    if Store.can-host: Row {
                        label: "Host the sync hub on this computer";
                        hint: "Other devices on your tailnet connect here. Keep Patch running (it lives in the tray).";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.hosting; toggled(v) => { Actions.set-hosting(v); } }
                    }
                    if Store.can-host && Store.hosting: Rectangle {
                        border-radius: 12px;
                        background: Theme.well;
                        height: pair.preferred-height;
                        pair := VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            SectionLabel { text: "PAIR YOUR PHONE"; }
                            Text { text: Store.host-urls == "" ? "Tailscale isn't running on this computer yet." : Store.host-urls; color: Theme.text; font-size: Theme.fs-m; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Token"; color: Theme.text-2; font-size: Theme.fs-m; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: Store.host-token; color: Theme.text; font-size: Theme.fs-l; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                                Button { text: "Copy"; kind: 3; clicked => { Actions.copy-text(Store.host-token); } }
                            }
                        }
                    }

                    SectionLabel { text: Store.can-host ? "OR CONNECT TO ANOTHER HUB" : "HUB"; }
                    Field {
                        text <=> root.url-input;
                        placeholder: "Hub address, e.g. my-laptop or 100.101.102.103";
                        input-type: InputType.text;
                    }
                    Field {
                        text <=> root.token-input;
                        placeholder: "Pairing token (XXXX-XXXX-XXXX-XXXX)";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if Store.hub-url != "": Button { text: "Disconnect"; kind: 3; clicked => { Actions.disconnect-hub(); } }
                        Button {
                            text: "Connect";
                            kind: 1;
                            enabled: root.url-input != "" && root.token-input != "";
                            clicked => { Actions.connect-hub(root.url-input, root.token-input); }
                        }
                    }
                }

                if !Store.mobile: Card {
                    title: "Always on";
                    icon: "pin";
                    Row {
                        label: "Floating widget";
                        hint: "A small always-on-top Today panel with quick add.";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.widget-on; toggled(v) => { Actions.set-widget(v); } }
                    }
                    Row {
                        label: "Start Patch at login";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.autostart; toggled(v) => { Actions.set-autostart(v); } }
                    }
                }

                if Store.mobile: Card {
                    title: "Display over other apps";
                    icon: "pin";
                    Row {
                        label: "Floating Patch bubble";
                        hint: Store.overlay-allowed ? "Today's tasks and quick add, floating above every app." : "Android needs the “Display over other apps” permission — you'll be taken to the setting.";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.overlay-on; toggled(v) => { Actions.set-overlay(v); } }
                    }
                    Row {
                        label: "Show bubble after restart";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.overlay-boot; toggled(v) => { Actions.set-overlay-boot(v); } }
                    }
                }

                Card {
                    title: "About";
                    icon: "note";
                    Text {
                        text: "Patch \{Store.version} — native Rust, rendered with Slint (Made with Slint). Your data lives on your devices and syncs only across your tailnet.";
                        color: Theme.text-2;
                        font-size: Theme.fs-s;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
