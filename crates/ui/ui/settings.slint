import { Theme } from "theme.slint";
import { Icon, IconBox } from "icons.slint";
import { Store, Actions, ThemeCard } from "store.slint";
import { Glass, Field, Toggle, IconButton, Button, Scroll, SectionLabel, Divider, Segmented } from "widgets.slint";

// A miniature of the range picker drawn in a theme's own colours.
component ThemePreview inherits Rectangle {
    in property <ThemeCard> theme;
    in property <bool> selected;
    callback picked();
    border-radius: 16px;
    // Phones use the software renderer, which can't round gradient corners.
    background: Store.mobile ? theme.mid : @linear-gradient(165deg, theme.top 0%, theme.bottom 100%);
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.hairline;
    clip: true;
    card := Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 38px;
        border-radius: 12px;
        background: root.theme.card;
        border-width: 1px;
        border-color: root.theme.edge;
        property <length> cw: (self.width - 12px) / 7;
        property <length> rh: (self.height - 22px) / 3;
        Text { x: 7px; y: 5px; text: "October"; color: root.theme.ink; font-size: 8px; font-weight: 700; }
        // The selected range 13–15 as one capsule under the end circles.
        Rectangle {
            x: 6px + 1.5 * card.cw - card.rh * 0.42;
            y: 18px + card.rh + (card.rh - self.height) / 2;
            width: 2 * card.cw + card.rh * 0.84;
            height: card.rh * 0.84;
            border-radius: self.height / 2;
            background: root.theme.band;
        }
        for r in 3: Rectangle {
            y: 18px + r * card.rh;
            height: card.rh;
            for c in 7: day := Rectangle {
                property <int> d: r * 7 + c + 5;
                property <bool> end: d == 13 || d == 15;
                x: 6px + c * card.cw;
                width: card.cw;
                Rectangle {
                    width: card.rh * 0.84;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: day.end ? root.theme.accent : transparent;
                    Text { text: d; font-size: 6.5px; font-weight: day.end ? 700 : 500; color: day.end ? #ffffff : root.theme.ink; }
                }
            }
        }
    }
    Text {
        y: parent.height - 26px;
        width: parent.width;
        text: root.theme.name;
        horizontal-alignment: center;
        font-size: Theme.fs-s;
        font-weight: 600;
        color: root.theme.ink;
        overflow: elide;
    }
    TouchArea { clicked => { root.picked(); } }
}

// Removable preset chip.
component Preset inherits Rectangle {
    in property <string> text;
    callback removed();
    height: Store.mobile ? 32px : 28px;
    width: lbl.preferred-width + 40px;
    border-radius: self.height / 2;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.hairline;
    lbl := Text { x: 12px; text: root.text; color: Theme.text; font-size: Theme.fs-s; font-weight: 500; }
    IconButton {
        x: parent.width - self.width - 4px;
        icon: "close";
        size: 20px;
        icon-size: 10px;
        round: true;
        clicked => { root.removed(); }
    }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 12px;
    min-height: Store.mobile ? 48px : 36px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.label; color: Theme.text; font-size: Theme.fs-m; font-weight: 500; }
        if root.hint != "": Text { text: root.hint; color: Theme.text-2; font-size: Theme.fs-s; wrap: word-wrap; }
    }
    @children
}

component Card inherits Glass {
    in property <string> title;
    in property <string> icon;
    fill: Theme.panel-strong;
    sheen: !Theme.matte;
    radius: 16px;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            if root.icon != "": IconBox { name: root.icon; size: 14px; tint: Theme.accent; }
            Text { text: root.title; font-size: Theme.fs-l; font-weight: 700; color: Theme.text; }
        }
        @children
    }
}

export component SettingsPanel inherits Rectangle {
    property <string> url-input: Store.hub-url;
    property <string> token-input: Store.hub-token;
    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-left: 18px;
            height: Store.mobile ? 60px : 52px;
            Text {
                horizontal-stretch: 1;
                text: "Settings";
                font-size: Theme.fs-xl;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: "close";
                clicked => { Store.settings-open = false; }
            }
        }
        scroll := Scroll {
            vertical-stretch: 1;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: scroll.width;
                alignment: start;
                padding: 16px;
                padding-top: 4px;
                padding-bottom: 40px;
                spacing: 14px;

                Card {
                    title: "Appearance";
                    icon: "layers";
                    themes := Rectangle {
                        property <int> cols: Store.mobile ? 2 : 5;
                        property <length> gap: 10px;
                        property <length> cw: (self.width - (self.cols - 1) * self.gap) / self.cols;
                        property <length> ch: 112px;
                        height: Math.ceil(Store.themes.length / self.cols) * (self.ch + self.gap) - self.gap;
                        for t[i] in Store.themes: ThemePreview {
                            x: Math.mod(i, themes.cols) * (themes.cw + themes.gap);
                            y: Math.floor(i / themes.cols) * (themes.ch + themes.gap);
                            width: themes.cw;
                            height: themes.ch;
                            theme: t;
                            selected: Store.theme == i;
                            picked => { Actions.set-look(i); }
                        }
                    }
                    Row {
                        label: "Patch's colour";
                        HorizontalLayout {
                            alignment: end;
                            spacing: 6px;
                            for c[i] in Store.pet-skins: Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 22px;
                                height: 22px;
                                border-radius: self.width / 2;
                                background: c;
                                border-width: Store.pet-skin == i ? 2px : 0px;
                                border-color: Theme.text;
                                if Store.pet-skin == i: Icon { name: "check"; size: 12px; tint: #ffffff; stroke-width: 3px; }
                                TouchArea { clicked => { Actions.set-pet-skin(i); } }
                            }
                        }
                    }
                    Row {
                        label: "Week starts on Monday";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.week-monday; toggled(v) => { Actions.set-week-monday(v); } }
                    }
                    Row {
                        label: "24-hour time";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.time-24h; toggled(v) => { Actions.set-time-24h(v); } }
                    }
                }

                presets := Card {
                    title: "Repeat & alerts";
                    icon: "repeat";
                    property <int> n: 2;
                    property <int> unit: 1;
                    property <int> amount: 30;
                    property <int> scale: 0;
                    Text {
                        text: "Add your own timings; they appear in every task's Repeat and Alert menus.";
                        color: Theme.text-2;
                        font-size: Theme.fs-s;
                        wrap: word-wrap;
                    }
                    SectionLabel { text: "CUSTOM REPEATS"; }
                    if Store.custom-repeats.length == 0: Text { text: "None yet"; color: Theme.text-3; font-size: Theme.fs-s; }
                    for r[i] in Store.custom-repeats: HorizontalLayout {
                        alignment: start;
                        Preset { text: r; removed => { Actions.remove-custom-repeat(i); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text { text: "Every"; color: Theme.text; font-size: Theme.fs-m; vertical-alignment: center; }
                        IconButton { y: (parent.height - self.height) / 2; icon: "minus"; size: 26px; icon-size: 12px; clicked => { presets.n = Math.max(1, presets.n - 1); } }
                        Text { text: presets.n; min-width: 22px; horizontal-alignment: center; color: Theme.text; font-size: Theme.fs-l; font-weight: 700; vertical-alignment: center; }
                        IconButton { y: (parent.height - self.height) / 2; icon: "plus"; size: 26px; icon-size: 12px; clicked => { presets.n = Math.min(365, presets.n + 1); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 1;
                            stretch: true;
                            items: ["days", "weeks", "months", "years"];
                            current: presets.unit;
                            picked(u) => { presets.unit = u; }
                        }
                        Button { y: (parent.height - self.height) / 2; text: "Add"; kind: 1; clicked => { Actions.add-custom-repeat(presets.n, presets.unit); } }
                    }
                    SectionLabel { text: "CUSTOM ALERTS"; }
                    if Store.custom-alerts.length == 0: Text { text: "None yet"; color: Theme.text-3; font-size: Theme.fs-s; }
                    for a[i] in Store.custom-alerts: HorizontalLayout {
                        alignment: start;
                        Preset { text: a; removed => { Actions.remove-custom-alert(i); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        IconButton { y: (parent.height - self.height) / 2; icon: "minus"; size: 26px; icon-size: 12px; clicked => { presets.amount = Math.max(1, presets.amount - (presets.scale == 0 ? 5 : 1)); } }
                        Text { text: presets.amount; min-width: 26px; horizontal-alignment: center; color: Theme.text; font-size: Theme.fs-l; font-weight: 700; vertical-alignment: center; }
                        IconButton { y: (parent.height - self.height) / 2; icon: "plus"; size: 26px; icon-size: 12px; clicked => { presets.amount = Math.min(presets.scale == 2 ? 365 : 999, presets.amount + (presets.scale == 0 ? 5 : 1)); } }
                        Text { text: "before"; color: Theme.text; font-size: Theme.fs-m; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 1;
                            stretch: true;
                            items: ["min", "hours", "days"];
                            current: presets.scale;
                            picked(u) => { presets.scale = u; presets.amount = Math.min(presets.amount, u == 2 ? 365 : 999); }
                        }
                        Button {
                            y: (parent.height - self.height) / 2;
                            text: "Add";
                            kind: 1;
                            clicked => { Actions.add-custom-alert(presets.amount * (presets.scale == 0 ? 1 : presets.scale == 1 ? 60 : 1440)); }
                        }
                    }
                }

                Card {
                    title: "Sync";
                    icon: "sync";
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Store.sync-state == 2 ? Theme.success : Store.sync-state == 1 ? Theme.warning : Store.sync-state == 0 ? Theme.text-3 : Theme.danger;
                        }
                        Text { horizontal-stretch: 1; text: Store.sync-label; color: Theme.text-2; font-size: Theme.fs-s; wrap: word-wrap; }
                    }

                    if Store.can-host: Row {
                        label: "Host the sync hub on this computer";
                        hint: "Devices on your tailnet or the same Wi-Fi connect here. Keep Patch running (it lives in the tray).";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.hosting; toggled(v) => { Actions.set-hosting(v); } }
                    }
                    if Store.can-host && Store.hosting: Rectangle {
                        border-radius: 12px;
                        background: Theme.well;
                        height: pair.preferred-height;
                        pair := VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            SectionLabel { text: "PAIR YOUR PHONE"; }
                            Text { text: Store.host-urls == "" ? "No network yet: connect to Wi-Fi or start Tailscale." : Store.host-urls; color: Theme.text; font-size: Theme.fs-m; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Token"; color: Theme.text-2; font-size: Theme.fs-m; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: Store.host-token; color: Theme.text; font-size: Theme.fs-l; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                                Button { text: "Copy"; kind: 3; clicked => { Actions.copy-text(Store.host-token); } }
                            }
                            if Store.host-urls != "": HorizontalLayout {
                                spacing: 12px;
                                Image {
                                    width: 148px;
                                    height: 148px;
                                    source: Store.host-qr;
                                    image-rendering: pixelated;
                                    accessible-role: image;
                                    accessible-label: "Pairing QR code";
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "On your phone: Patch → Settings → Scan pairing QR code. Without Tailscale, keep both on the same Wi-Fi (unencrypted there, so use a network you trust).";
                                    color: Theme.text-2;
                                    font-size: Theme.fs-s;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    SectionLabel { text: Store.can-host ? "OR CONNECT TO ANOTHER HUB" : "HUB"; }
                    if Store.can-scan: Button {
                        text: "Scan pairing QR code";
                        kind: 1;
                        clicked => { Actions.scan-pair(); }
                    }
                    Field {
                        text <=> root.url-input;
                        placeholder: "Hub address, e.g. my-laptop or 100.101.102.103";
                        input-type: InputType.text;
                    }
                    Field {
                        text <=> root.token-input;
                        placeholder: "Pairing token (XXXX-XXXX-XXXX-XXXX)";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if Store.hub-url != "": Button { text: "Disconnect"; kind: 3; clicked => { Actions.disconnect-hub(); } }
                        Button {
                            text: "Connect";
                            kind: 1;
                            enabled: root.url-input != "" && root.token-input != "";
                            clicked => { Actions.connect-hub(root.url-input, root.token-input); }
                        }
                    }
                }

                Card {
                    title: "Usage";
                    icon: "clock";
                    // Refreshes only while Settings is open.
                    Timer {
                        interval: 2s;
                        running: true;
                        triggered => { Actions.refresh-usage(); }
                    }
                    init => { Actions.refresh-usage(); }
                    Text { text: Store.usage; color: Theme.text-2; font-size: Theme.fs-s; wrap: word-wrap; }
                    if Store.battery-usage != "": VerticalLayout {
                        spacing: 2px;
                        Text { text: Store.battery-usage; color: Theme.text-2; font-size: Theme.fs-s; wrap: word-wrap; }
                        Text { text: "Device readings; Patch's share of battery use is unavailable."; color: Theme.text-2; font-size: Theme.fs-s; wrap: word-wrap; }
                    }
                    if Store.mobile: Button {
                        text: "App battery settings";
                        kind: 3;
                        clicked => { Actions.battery-settings(); }
                    }
                    if Store.battery-state != 0: Row {
                        label: Store.battery-state == 2 ? "Battery optimization is off for Patch" : "Android may pause Patch to save battery";
                        hint: Store.battery-state == 2 ? "Reminders, sync and the bubble keep running in the background." : "Late reminders or a vanishing bubble? Let Patch run unrestricted.";
                        if Store.battery-state == 1: Button {
                            y: (parent.height - self.height) / 2;
                            text: "Allow";
                            kind: 3;
                            clicked => { Actions.battery-unrestrict(); }
                        }
                    }
                }

                if !Store.mobile: Card {
                    title: "Always on";
                    icon: "pin";
                    Row {
                        label: "Desktop widget";
                        hint: "Tiles on your desktop; Patch's pet above apps, with tasks and quick add.";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.widget-on; toggled(v) => { Actions.set-widget(v); } }
                    }
                    Row {
                        label: "Keep Patch on top";
                        hint: "The main window stays above other apps, even when you click elsewhere.";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.pinned; toggled(v) => { Actions.set-pinned(v); } }
                    }
                    Row {
                        label: "Start Patch at login";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.autostart; toggled(v) => { Actions.set-autostart(v); } }
                    }
                }

                if Store.mobile: Card {
                    title: "Display over other apps";
                    icon: "pin";
                    Row {
                        label: "Floating Patch bubble";
                        hint: Store.overlay-allowed ? "Today's tasks and quick add, floating above every app." : "Android needs the “Display over other apps” permission — you'll be taken to the setting.";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.overlay-on; toggled(v) => { Actions.set-overlay(v); } }
                    }
                    Row {
                        label: "Show bubble after restart";
                        Toggle { y: (parent.height - self.height) / 2; checked: Store.overlay-boot; toggled(v) => { Actions.set-overlay-boot(v); } }
                    }
                }

                Card {
                    title: "About";
                    icon: "note";
                    Text {
                        text: "Patch \{Store.version} — native Rust on Linux and Android. Your data lives on your devices and syncs only across your tailnet.";
                        color: Theme.text-2;
                        font-size: Theme.fs-s;
                        wrap: word-wrap;
                    }
                    if Store.can-update: Button {
                        text: "Check for updates";
                        clicked => { Actions.check-update(); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: badge.preferred-width + 20px;
                            height: 26px;
                            border-radius: 13px;
                            background: Theme.well;
                            border-width: 1px;
                            border-color: Theme.hairline;
                            badge := Text {
                                text: "Made with Slint · slint.dev";
                                font-size: Theme.fs-s;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}
