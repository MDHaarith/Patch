// Design tokens. Every colour is set from Rust (src/themes.rs) so themes are
// data; the defaults here are Matte Black, used until the app applies one.

export global Theme {
    in-out property <bool> compact: false;
    // Flavour flags some components use for subtle structural choices.
    in-out property <bool> light: false;
    out property <bool> matte: !light;

    // Backdrop colours.
    in-out property <color> backdrop-top: #0b0b0c;
    in-out property <color> backdrop-bottom: #060607;
    out property <brush> backdrop: @linear-gradient(165deg, backdrop-top 0%, backdrop-bottom 100%);
    // Opaque base colour for full-screen sheets on phones.
    in-out property <color> solid: #0b0b0c;

    in-out property <color> panel: #121214;
    in-out property <color> panel-strong: #18181b;
    in-out property <color> content: #0e0e10;
    in-out property <color> float: #161618f2;
    in-out property <color> modal: #111113f7;
    in-out property <color> dock: #18181bf2;
    in-out property <color> card: #1c1c1f;
    in-out property <color> picker: #1c1c1e;
    in-out property <color> bubble-top: #2a2a2e;
    in-out property <color> bubble-bottom: #0e0e10;
    out property <brush> bubble: @linear-gradient(180deg, bubble-top 0%, bubble-bottom 100%);
    // The pet stays dark on every theme so its white eyes always read.
    in-out property <color> pet: #202024;
    in-out property <color> well: #ffffff0a;
    in-out property <color> hairline: #ffffff12;
    in-out property <color> edge: #ffffff1f;
    in-out property <color> sheen-color: #ffffff12;
    in-out property <float> sheen-reach: 0.45;
    out property <brush> sheen: @linear-gradient(180deg, sheen-color 0%, sheen-color.with-alpha(0) sheen-reach * 100%);
    in-out property <color> shadow: #00000099;

    in-out property <color> text: #f5f5f7;
    in-out property <color> text-2: #9a9aa1;
    in-out property <color> text-3: #56565c;
    in-out property <color> on-accent: #ffffff;

    in-out property <color> accent: #0a84ff;
    out property <color> accent-soft: accent.with-alpha(light ? 0.12 : 0.2);
    in-out property <color> today: #ff453a;
    in-out property <color> danger: #ff453a;
    in-out property <color> success: #30d158;
    in-out property <color> warning: #ff9f0a;

    in-out property <color> hover: #ffffff0f;
    in-out property <color> press: #ffffff1a;
    // The band between the ends of a selected date range.
    in-out property <color> range: #3a3a3d;
    in-out property <color> chip: #2c2c2f;
    in-out property <color> weekend: #ffffff04;
    in-out property <color> toast: #f5f5f7e6;
    in-out property <color> toast-text: #111113;

    out property <duration> motion-fast: 120ms;
    out property <duration> motion-panel: 240ms;
    out property <duration> motion-enter: 260ms;
    out property <duration> motion-exit: 200ms;
    // Slint cannot expose easing properties; panels use these curves inline:
    // enter: cubic-bezier(0.2, 0, 0, 1), exit: cubic-bezier(0.4, 0, 1, 1).

    out property <length> r-s: 6px;
    out property <length> r-m: 10px;
    out property <length> r-l: 16px;
    out property <length> r-xl: 26px;

    out property <length> fs-xs: 11px;
    out property <length> fs-s: 12px;
    out property <length> fs-m: 13px;
    out property <length> fs-l: 15px;
    out property <length> fs-xl: 22px;
    out property <length> fs-title: compact ? 26px : 28px;
}
