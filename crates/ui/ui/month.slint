import { Theme } from "theme.slint";
import { Store, Actions } from "store.slint";
import { Scroll, Divider, SectionLabel } from "widgets.slint";
import { TaskRow } from "rows.slint";

// Phone month: dots under the days and the selected day's agenda below.
component CompactMonth inherits VerticalLayout {
    property <length> cell-h: 46px;
    spacing: 6px;
    heads := Rectangle {
        height: 18px;
        for d[i] in Store.weekdays: Text {
            x: 8px + i * (heads.width - 16px) / 7;
            width: (heads.width - 16px) / 7;
            text: d;
            horizontal-alignment: center;
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.text-2;
        }
    }
    grid := Rectangle {
        height: 6 * root.cell-h;
        for cell[i] in Store.month-cells: Rectangle {
            x: 8px + Math.mod(i, 7) * ((grid.width - 16px) / 7);
            y: Math.floor(i / 7) * root.cell-h;
            width: (grid.width - 16px) / 7;
            height: root.cell-h;
            Rectangle {
                y: 4px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: cell.today ? Theme.today : cell.selected ? Theme.accent : transparent;
                Text {
                    text: cell.day;
                    font-size: 16px;
                    font-weight: cell.today || cell.selected ? 700 : 500;
                    color: cell.today || cell.selected ? #ffffff : cell.in-month ? (cell.weekend ? Theme.text-2 : Theme.text) : Theme.text-3;
                }
            }
            HorizontalLayout {
                y: 38px;
                height: 5px;
                alignment: center;
                spacing: 3px;
                for c[k] in cell.dots: Rectangle {
                    visible: k < 3;
                    width: k < 3 ? 5px : 0px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: c;
                }
            }
            TouchArea {
                clicked => { Actions.select-date(cell.key); }
                double-clicked => { Actions.new-task(cell.key, -1); }
            }
        }
    }
    Divider {}
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 4px;
        SectionLabel { text: Store.day-agenda-title; vertical-alignment: center; }
    }
    agenda-scroll := Scroll {
        vertical-stretch: 1;
        content-height: agenda.preferred-height;
        agenda := VerticalLayout {
            width: agenda-scroll.width;
            alignment: start;
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 90px;
            for item in Store.day-agenda: TaskRow {
                item: item;
                opened(id) => { Actions.open-task(id); }
            }
            if Store.day-agenda.length == 0: Text {
                text: "Nothing planned. Tap + to add.";
                horizontal-alignment: center;
                color: Theme.text-3;
                font-size: Theme.fs-m;
                height: 60px;
                vertical-alignment: center;
            }
        }
    }
}

export component MonthView inherits Rectangle {
    CompactMonth {
        width: parent.width;
        height: parent.height;
    }
}
