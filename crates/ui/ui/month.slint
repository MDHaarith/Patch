import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Store, Actions, DayCell } from "store.slint";
import { Scroll, Divider, SectionLabel } from "widgets.slint";
import { TaskRow } from "rows.slint";

// macOS Calendar month grid. Items can be dragged onto another day.
component DesktopMonth inherits Rectangle {
    property <length> head-h: 30px;
    property <length> cell-w: self.width / 7;
    property <length> cell-h: (self.height - head-h) / 6;
    property <length> item-h: 19px;
    property <int> max-items: Math.max(1, Math.floor((cell-h - 30px) / (item-h + 2px)));
    property <bool> dragging: false;
    property <string> drag-id;
    property <string> drag-title;
    property <color> drag-color;
    property <length> drag-x;
    property <length> drag-y;
    property <int> drop-index: Math.clamp(Math.floor(drag-x / cell-w), 0, 6) + 7 * Math.clamp(Math.floor((drag-y - head-h) / cell-h), 0, 5);

    // Weekday header, right aligned like macOS.
    for d[i] in Store.weekdays-short: Text {
        x: i * root.cell-w;
        y: 0;
        width: root.cell-w - 10px;
        height: root.head-h;
        text: d;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: Theme.fs-s;
        font-weight: 500;
        color: Theme.text-2;
    }
    Rectangle { y: root.head-h - 1px; height: 1px; background: Theme.hairline; }

    for cell[i] in Store.month-cells: Rectangle {
        property <length> cx: Math.mod(i, 7) * root.cell-w;
        property <length> cy: root.head-h + Math.floor(i / 7) * root.cell-h;
        x: cx;
        y: cy;
        width: root.cell-w;
        height: root.cell-h;
        background: root.dragging && root.drop-index == i ? Theme.accent-soft : cell.weekend ? Theme.weekend : transparent;

        bg-ta := TouchArea {
            clicked => { Actions.select-date(cell.key); }
            double-clicked => { Actions.new-task(cell.key, -1); }
        }
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.hairline; }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.hairline; }

        // Day number, top right; today gets the red circle.
        Rectangle {
            x: parent.width - self.width - 6px;
            y: 5px;
            height: 22px;
            width: cell.today ? Math.max(22px, num.preferred-width + 12px) : num.preferred-width + 4px;
            border-radius: 11px;
            background: cell.today ? Theme.today : transparent;
            num := Text {
                text: cell.label;
                font-size: Theme.fs-m;
                font-weight: cell.today ? 700 : (cell.day == 1 ? 650 : 500);
                color: cell.today ? #ffffff : cell.in-month ? Theme.text : Theme.text-3;
            }
        }
        if cell.selected && !cell.today: Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 5px;
            height: parent.height - 5px;
            border-radius: 6px;
            border-width: 1.5px;
            border-color: Theme.accent.with-alpha(0.65);
        }

        for item[j] in cell.items: Rectangle {
            property <bool> shown: j < root.max-items || (j == root.max-items && cell.items.length == root.max-items + 1 && cell.more == 0);
            visible: shown && item.kind != 0;
            x: item.kind == 1 && item.cont-left ? 0 : 4px;
            y: 31px + j * (root.item-h + 2px);
            width: parent.width - (item.kind == 1 && item.cont-left ? 0 : 4px) - (item.kind == 1 && item.cont-right ? 0 : 5px);
            height: root.item-h;
            border-top-left-radius: item.kind == 1 && item.cont-left ? 0 : 4px;
            border-bottom-left-radius: item.kind == 1 && item.cont-left ? 0 : 4px;
            border-top-right-radius: item.kind == 1 && item.cont-right ? 0 : 4px;
            border-bottom-right-radius: item.kind == 1 && item.cont-right ? 0 : 4px;
            background: item.kind == 1 ? item.color.with-alpha(Theme.light ? 0.22 : 0.32) : ita.has-hover ? Theme.hover : transparent;
            opacity: root.dragging && root.drag-id == item.id ? 0.35 : (item.done ? 0.5 : 1);

            if item.kind == 1 && !item.cont-left: Rectangle {
                x: 0;
                width: 3px;
                border-top-left-radius: 4px;
                border-bottom-left-radius: 4px;
                background: item.color;
            }
            HorizontalLayout {
                padding-left: item.kind == 1 ? 7px : 3px;
                padding-right: 4px;
                spacing: 5px;
                if item.kind == 2: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: item.color;
                }
                Text {
                    horizontal-stretch: 1;
                    text: item.title;
                    font-size: Theme.fs-s;
                    font-weight: item.kind == 1 ? 600 : 500;
                    color: item.kind == 1 ? (Theme.light ? item.color.darker(0.35) : item.color.brighter(0.45)) : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if item.kind == 2 && root.cell-w > 110px: Text {
                    text: item.time;
                    font-size: Theme.fs-xs;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
            }
            ita := TouchArea {
                clicked => {
                    if (!root.dragging) {
                        Actions.open-task(item.id);
                    }
                }
                moved => {
                    if (self.pressed && !root.dragging && (Math.abs(self.mouse-x - self.pressed-x) > 5px || Math.abs(self.mouse-y - self.pressed-y) > 5px)) {
                        root.dragging = true;
                        root.drag-id = item.id;
                        root.drag-title = item.title;
                        root.drag-color = item.color;
                    }
                    if (root.dragging) {
                        root.drag-x = cx + parent.x + self.mouse-x;
                        root.drag-y = cy + parent.y + self.mouse-y;
                    }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up && root.dragging) {
                        root.dragging = false;
                        if (root.drop-index != i) {
                            Actions.drop-on-date(root.drag-id, Store.month-cells[root.drop-index].key);
                        }
                    }
                    if (e.kind == PointerEventKind.cancel) {
                        root.dragging = false;
                    }
                }
            }
        }

        property <int> hidden: Math.max(0, cell.items.length - root.max-items) + cell.more;
        if hidden > 1 || (hidden == 1 && cell.more > 0): Text {
            x: 8px;
            y: parent.height - 18px;
            text: "\{hidden} more";
            font-size: Theme.fs-xs;
            font-weight: 600;
            color: Theme.text-2;
            TouchArea { clicked => { Actions.select-date(cell.key); Actions.set-view(0); } }
        }
    }

    if root.dragging: Rectangle {
        x: root.drag-x - 12px;
        y: root.drag-y - 11px;
        width: Math.min(root.cell-w, 180px);
        height: 22px;
        border-radius: 5px;
        background: root.drag-color.with-alpha(0.9);
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000080;
        Text {
            x: 8px;
            width: parent.width - 12px;
            text: root.drag-title;
            color: #ffffff;
            font-size: Theme.fs-s;
            font-weight: 600;
            overflow: elide;
        }
    }
}

// Phone month: dots under the days and the selected day's agenda below.
component CompactMonth inherits VerticalLayout {
    property <length> cell-h: 46px;
    spacing: 6px;
    heads := Rectangle {
        height: 18px;
        for d[i] in Store.weekdays: Text {
            x: 8px + i * (heads.width - 16px) / 7;
            width: (heads.width - 16px) / 7;
            text: d;
            horizontal-alignment: center;
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.text-2;
        }
    }
    grid := Rectangle {
        height: 6 * root.cell-h;
        for cell[i] in Store.month-cells: Rectangle {
            x: 8px + Math.mod(i, 7) * ((grid.width - 16px) / 7);
            y: Math.floor(i / 7) * root.cell-h;
            width: (grid.width - 16px) / 7;
            height: root.cell-h;
            Rectangle {
                y: 4px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: cell.today ? Theme.today : cell.selected ? Theme.accent : transparent;
                Text {
                    text: cell.day;
                    font-size: 16px;
                    font-weight: cell.today || cell.selected ? 700 : 500;
                    color: cell.today || cell.selected ? #ffffff : cell.in-month ? (cell.weekend ? Theme.text-2 : Theme.text) : Theme.text-3;
                }
            }
            HorizontalLayout {
                y: 38px;
                height: 5px;
                alignment: center;
                spacing: 3px;
                for c[k] in cell.dots: Rectangle {
                    visible: k < 3;
                    width: k < 3 ? 5px : 0px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: c;
                }
            }
            TouchArea {
                clicked => { Actions.select-date(cell.key); }
                double-clicked => { Actions.new-task(cell.key, -1); }
            }
        }
    }
    Divider {}
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 4px;
        SectionLabel { text: Store.day-agenda-title; vertical-alignment: center; }
    }
    agenda-scroll := Scroll {
        vertical-stretch: 1;
        content-height: agenda.preferred-height;
        agenda := VerticalLayout {
            width: agenda-scroll.width;
            alignment: start;
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 90px;
            for item in Store.day-agenda: TaskRow {
                item: item;
                opened(id) => { Actions.open-task(id); }
            }
            if Store.day-agenda.length == 0: Text {
                text: "Nothing planned. Tap + to add.";
                horizontal-alignment: center;
                color: Theme.text-3;
                font-size: Theme.fs-m;
                height: 60px;
                vertical-alignment: center;
            }
        }
    }
}

export component MonthView inherits Rectangle {
    if !Store.mobile: DesktopMonth {
        width: parent.width;
        height: parent.height;
    }
    if Store.mobile: CompactMonth {
        width: parent.width;
        height: parent.height;
    }
}
