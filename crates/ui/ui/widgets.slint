import { Theme } from "theme.slint";
import { Icon, IconBox } from "icons.slint";
import { Store, Actions } from "store.slint";

// A glass surface: translucent fill, hairline edge, specular sheen and a
// soft shadow. Matte mode uses an opaque near-black fill instead.
export component Glass inherits Rectangle {
    in property <length> radius: Theme.r-l;
    in property <color> fill: Theme.panel;
    in property <bool> elevated: false;
    in property <bool> sheen: true;
    border-radius: radius;
    background: fill;
    border-width: 1px;
    border-color: Theme.hairline;
    drop-shadow-blur: elevated ? 28px : 0px;
    drop-shadow-offset-y: elevated ? 10px : 0px;
    drop-shadow-color: elevated ? Theme.shadow : transparent;
    if sheen: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: Math.min(parent.height, 48px);
        border-radius: root.radius;
        background: Theme.sheen;
    }
    @children
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.hairline;
}

export component SectionLabel inherits Text {
    color: Theme.text-2;
    font-size: Theme.fs-xs;
    font-weight: 600;
    letter-spacing: 0.4px;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 30px;
    in property <length> icon-size: 16px;
    in property <color> tint: Theme.text-2;
    in property <bool> active: false;
    in property <bool> round: false;
    callback clicked();
    width: size;
    height: size;
    border-radius: round ? size / 2 : Theme.r-s + 1px;
    background: active ? Theme.accent-soft : ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    Icon {
        name: root.icon;
        size: root.icon-size;
        tint: root.active ? Theme.accent : root.tint;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// kind: 0 secondary, 1 primary, 2 danger, 3 plain
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    in property <length> pad: 14px;
    callback clicked();
    height: Store.mobile ? 40px : 30px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: Store.mobile ? 12px : 8px;
    opacity: enabled ? 1 : 0.45;
    background: kind == 1
        ? (ta.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : kind == 2
            ? (ta.pressed ? Theme.danger.with-alpha(0.3) : Theme.danger.with-alpha(0.16))
            : kind == 3
                ? (ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent)
                : (ta.pressed ? Theme.press : Theme.chip);
    animate background { duration: 120ms; }
    lay := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 6px;
        alignment: center;
        if root.icon != "": IconBox {
            name: root.icon;
            size: 14px;
            tint: root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.danger : Theme.text;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Store.mobile ? Theme.fs-l : Theme.fs-m;
            font-weight: 500;
            color: root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.danger : Theme.text;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// macOS-style segmented control.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <[string]> icons;
    in-out property <int> current;
    in property <length> seg-height: Store.mobile ? 34px : 28px;
    in property <bool> stretch: false;
    callback picked(int);
    height: seg-height;
    border-radius: Store.mobile ? 10px : 8px;
    background: Theme.well;
    border-width: Theme.light ? 0px : 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            horizontal-stretch: root.stretch ? 1 : 0;
            min-width: inner.preferred-width + (Store.mobile ? 20px : 22px);
            border-radius: Store.mobile ? 8px : 6px;
            background: i == root.current ? (Theme.light ? #ffffff : Theme.glass ? #ffffff40 : #3a3a3e) : sta.has-hover ? Theme.hover : transparent;
            drop-shadow-blur: i == root.current ? 3px : 0px;
            drop-shadow-offset-y: i == root.current ? 1px : 0px;
            drop-shadow-color: i == root.current ? #0000002e : transparent;
            animate background { duration: 140ms; }
            inner := HorizontalLayout {
                alignment: center;
                spacing: 5px;
                if i < root.icons.length && root.icons[i] != "": IconBox {
                    name: root.icons[i];
                    size: 13px;
                    tint: i == root.current ? Theme.text : Theme.text-2;
                }
                Text {
                    text: item;
                    vertical-alignment: center;
                    font-size: Store.mobile ? Theme.fs-m : Theme.fs-s;
                    font-weight: i == root.current ? 600 : 500;
                    color: i == root.current ? Theme.text : Theme.text-2;
                }
            }
            sta := TouchArea {
                clicked => {
                    root.current = i;
                    root.picked(i);
                }
            }
        }
    }
}

// Single or multi-line text field. Tells the platform when it gains focus so
// Android can raise the soft keyboard.
export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <length> font-size: Store.mobile ? Theme.fs-l : Theme.fs-m;
    in property <int> font-weight: 400;
    in property <bool> multiline: false;
    in property <bool> boxed: true;
    in property <string> icon;
    in property <InputType> input-type: InputType.text;
    out property <bool> focused: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback escaped();
    min-height: multiline ? 72px : (Store.mobile ? 40px : 30px);
    max-height: multiline ? 100000px : (Store.mobile ? 40px : 30px);
    vertical-stretch: multiline ? 1 : 0;
    border-radius: Store.mobile ? 12px : 8px;
    background: boxed ? Theme.well : transparent;
    border-width: boxed ? 1px : 0px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.7) : (boxed ? Theme.hairline : transparent);
    animate border-color { duration: 120ms; }

    public function focus-input() {
        input.focus();
    }
    public function blur-input() {
        input.clear-focus();
    }

    // The whole box focuses the input, not just the line of text.
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: root.boxed ? 10px : 0px;
        padding-right: root.boxed ? 10px : 0px;
        padding-top: root.multiline ? 8px : 0px;
        padding-bottom: root.multiline ? 8px : 0px;
        spacing: 7px;
        if root.icon != "": IconBox {
            name: root.icon;
            size: 14px;
            tint: Theme.text-3;
        }
        Rectangle {
            horizontal-stretch: 1;
            placeholder-text := Text {
                x: 0;
                y: root.multiline ? 0 : (parent.height - self.height) / 2;
                width: parent.width;
                text: root.placeholder;
                visible: input.text == "" && input.preedit-text == "";
                color: Theme.text-3;
                font-size: root.font-size;
                font-weight: root.font-weight;
                overflow: elide;
            }
            input := TextInput {
                x: 0;
                y: root.multiline ? 0 : (parent.height - self.height) / 2;
                width: parent.width;
                height: root.multiline ? parent.height : self.preferred-height;
                color: Theme.text;
                font-size: root.font-size;
                font-weight: root.font-weight;
                single-line: !root.multiline;
                wrap: root.multiline ? word-wrap : no-wrap;
                input-type: root.input-type;
                selection-background-color: Theme.accent.with-alpha(0.4);
                selection-foreground-color: Theme.text;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        self.clear-focus();
                        root.escaped();
                        return accept;
                    }
                    reject
                }
                changed has-focus => { Actions.text-focus(self.has-focus); }
            }
        }
    }
}

// iOS-style switch.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.success : Theme.chip;
    animate background { duration: 160ms; }
    knob := Rectangle {
        x: root.checked ? root.width - self.width - 2px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000040;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Round completion checkbox in the list colour, like Reminders.
export component Check inherits Rectangle {
    in property <bool> checked;
    in property <color> tint: Theme.accent;
    in property <length> size: Store.mobile ? 22px : 18px;
    callback toggled();
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: checked ? 0px : 1.5px;
    border-color: ta.has-hover ? tint : tint.with-alpha(0.75);
    background: checked ? tint : (ta.pressed ? tint.with-alpha(0.2) : transparent);
    animate background { duration: 140ms; }
    if root.checked: Icon {
        name: "check";
        size: root.size * 0.62;
        tint: #ffffff;
        stroke-width: 3px;
    }
    ta := TouchArea {
        clicked => { root.toggled(); }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <color> dot: transparent;
    in property <string> icon;
    callback clicked();
    height: Store.mobile ? 32px : 26px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.well;
    border-width: 1px;
    border-color: selected ? Theme.accent.with-alpha(0.65) : Theme.hairline;
    animate background { duration: 120ms; }
    lay := HorizontalLayout {
        padding-left: 10px;
        padding-right: 11px;
        spacing: 6px;
        alignment: center;
        if root.dot != transparent: Rectangle {
            width: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot;
            }
        }
        if root.icon != "": IconBox {
            name: root.icon;
            size: 12px;
            tint: root.selected ? Theme.accent : Theme.text-2;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Store.mobile ? Theme.fs-m : Theme.fs-s;
            font-weight: 500;
            color: root.selected ? Theme.accent : Theme.text;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Priority marks: ! / !! / !!!
export component Priority inherits Text {
    in property <int> level;
    text: level == 3 ? "!!!" : level == 2 ? "!!" : level == 1 ? "!" : "";
    color: level == 3 ? Theme.danger : level == 2 ? Theme.warning : Theme.text-2;
    font-weight: 800;
    font-size: Theme.fs-s;
    vertical-alignment: center;
}

// A scrolling area. Mouse-drag panning is a touch idiom, so only Android
// enables it; desktops scroll with the wheel and trackpad.
export component Scroll inherits Flickable {
    mouse-drag-pan-enabled: Store.mobile;
}

export component Toast inherits Rectangle {
    in property <string> text;
    visible: text != "";
    height: 36px;
    width: t.preferred-width + 32px;
    border-radius: 18px;
    background: Theme.light ? #1d1d1fe6 : #f5f5f7e6;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;
    t := Text {
        text: root.text;
        color: Theme.light ? #ffffff : #111113;
        font-size: Theme.fs-m;
        font-weight: 500;
    }
}
