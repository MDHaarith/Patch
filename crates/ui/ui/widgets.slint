import { Theme } from "theme.slint";
import { Icon, IconBox } from "icons.slint";
import { Store, Actions } from "store.slint";

// Shared panel surface.
export component Surface inherits Rectangle {
    in property <length> radius: Theme.r-l;
    in property <color> fill: Theme.panel;
    in property <bool> elevated: false;
    in property <bool> sheen: true;
    border-radius: radius;
    background: fill;
    animate background { duration: Theme.motion-panel; easing: cubic-bezier(0.2, 0, 0, 1); }
    border-width: 1px;
    // Gradient borders need the GPU renderer, like the sheen below.
    border-color: Theme.hairline;
    drop-shadow-blur: elevated ? 28px : 0px;
    drop-shadow-offset-y: elevated ? 10px : 0px;
    drop-shadow-color: elevated ? Theme.shadow : transparent;
    // Gradient + corner radius needs a GPU renderer; phones skip the sheen.
    if sheen && !Store.mobile: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: Math.min(parent.height, 48px);
        border-radius: root.radius;
        background: Theme.sheen;
    }
    @children
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.hairline;
}

export component SectionLabel inherits Text {
    color: Theme.text-2;
    font-size: Theme.fs-xs;
    font-weight: 600;
    letter-spacing: 0.4px;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 30px;
    in property <length> icon-size: 16px;
    in property <color> tint: Theme.text-2;
    in property <bool> active: false;
    in property <bool> round: false;
    callback clicked();
    width: size;
    height: size;
    border-radius: round ? size / 2 : Theme.r-s + 1px;
    background: active ? Theme.accent-soft : ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.motion-fast; easing: ease-out; }
    Icon {
        name: root.icon;
        size: root.icon-size;
        tint: root.active ? Theme.accent : root.tint;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// kind: 0 secondary, 1 primary, 2 danger, 3 plain
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    in property <length> pad: 14px;
    callback clicked();
    height: Store.mobile ? 40px : 30px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: Store.mobile ? 12px : 8px;
    opacity: enabled ? 1 : 0.45;
    background: kind == 1
        ? (ta.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : kind == 2
            ? (ta.pressed ? Theme.danger.with-alpha(0.3) : Theme.danger.with-alpha(0.16))
            : kind == 3
                ? (ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent)
                : (ta.pressed ? Theme.press : Theme.chip);
    animate background { duration: Theme.motion-fast; easing: ease-out; }
    lay := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 6px;
        alignment: center;
        if root.icon != "": IconBox {
            name: root.icon;
            size: 14px;
            tint: root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.danger : Theme.text;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Store.mobile ? Theme.fs-l : Theme.fs-m;
            font-weight: 500;
            color: root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.danger : Theme.text;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// macOS-style segmented control.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <[string]> icons;
    in-out property <int> current;
    in property <length> seg-height: Store.mobile ? 34px : 28px;
    in property <bool> stretch: false;
    callback picked(int);
    height: seg-height;
    border-radius: Store.mobile ? 10px : 8px;
    background: Theme.well;
    border-width: Theme.light ? 0px : 1px;
    border-color: Theme.hairline;
    pill := Rectangle {
        x: 2px;
        y: 2px;
        height: parent.height - 4px;
        width: 0px;
        border-radius: Store.mobile ? 8px : 6px;
        background: Theme.light ? #ffffff : Theme.range;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #0000002e;
        animate x, width { duration: Theme.motion-panel; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            property <bool> selected: i == root.current;
            function place-pill() {
                if self.selected {
                    pill.x = self.x;
                    pill.width = self.width;
                }
            }
            changed selected => { self.place-pill(); }
            changed x => { self.place-pill(); }
            changed width => { self.place-pill(); }
            horizontal-stretch: root.stretch ? 1 : 0;
            min-width: inner.preferred-width + (Store.mobile ? 20px : 22px);
            border-radius: Store.mobile ? 8px : 6px;
            background: !self.selected && sta.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.motion-fast; easing: ease-out; }
            inner := HorizontalLayout {
                alignment: center;
                spacing: 5px;
                if i < root.icons.length && root.icons[i] != "": IconBox {
                    name: root.icons[i];
                    size: 13px;
                    tint: i == root.current ? Theme.text : Theme.text-2;
                }
                Text {
                    text: item;
                    vertical-alignment: center;
                    font-size: Store.mobile ? Theme.fs-m : Theme.fs-s;
                    font-weight: i == root.current ? 600 : 500;
                    color: i == root.current ? Theme.text : Theme.text-2;
                }
            }
            sta := TouchArea {
                clicked => {
                    root.current = i;
                    root.picked(i);
                }
            }
        }
    }
}

// Mouse-drag panning is a touch idiom; desktops use the wheel and trackpad.
export component Scroll inherits Flickable {
    mouse-drag-pan-enabled: Store.mobile;
}

// Horizontal calendar navigation; vertical gestures stay with the scroll view.
export component SwipeNav inherits Rectangle {
    clip: true;
    in property <bool> enabled: Store.mobile;
    in property <bool> blocked: false;
    // Leave the old page mounted until it has travelled off screen. The incoming
    // page is snapped into view before its enter animation starts.
    property <int> phase: 0; // idle, outgoing, snap, incoming, spring back
    property <int> direction: 0;
    property <bool> snap: phase == 2;
    property <float> offset: gesture.swiping ? clamp((gesture.current-position.x - gesture.pressed-position.x) / root.width, -1, 1)
        : phase == 1 ? -direction : snap ? direction * 0.3 : 0;
    animate offset {
        duration: gesture.swiping || root.snap ? 0ms : root.phase == 1 ? 150ms : root.phase == 4 ? Theme.motion-exit : Theme.motion-panel;
        easing: root.phase == 1 ? cubic-bezier(0.4, 0, 1, 1) : cubic-bezier(0.2, 0, 0, 1);
    }
    Timer {
        interval: root.phase == 1 ? 150ms : root.snap ? 20ms : root.phase == 4 ? Theme.motion-exit : Theme.motion-panel;
        running: root.phase != 0;
        triggered => {
            if root.phase == 1 {
                root.phase = 2;
                Actions.nav(root.direction);
            } else if root.snap {
                root.phase = 3;
            } else {
                root.phase = 0;
            }
        }
    }
    gesture := SwipeGestureHandler {
        enabled: root.enabled && !root.blocked && root.phase == 0;
        handle-swipe-left: true;
        handle-swipe-right: true;
        swiped => {
            let dx = self.current-position.x - self.pressed-position.x;
            if (Math.abs(dx) > root.width * 0.2) {
                root.direction = dx < 0 ? 1 : -1;
                root.phase = 1;
            } else {
                root.phase = 4;
            }
        }
        body := Rectangle {
            width: root.width;
            height: root.height;
            x: root.offset * root.width;
            opacity: root.snap || root.phase == 3 ? 1 - 0.7 * min(1, abs(root.offset) / 0.3) : 1 - 0.7 * min(1, abs(root.offset));
            @children
        }
    }
}

// Wrapped text field. `multiline` makes Enter insert a newline instead of submit.
export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <length> font-size: Store.mobile ? Theme.fs-l : Theme.fs-m;
    in property <int> font-weight: 400;
    in property <bool> multiline: false;
    in property <bool> boxed: true;
    in property <string> icon;
    in property <InputType> input-type: InputType.text;
    out property <bool> focused: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback escaped();
    min-width: 0px;
    min-height: multiline ? 72px : (Store.mobile ? 40px : 30px);
    preferred-height: Math.max(self.min-height, multiline ? input.preferred-height + 16px : Math.min(160px, input.preferred-height + 16px));
    vertical-stretch: 0;
    border-radius: Store.mobile ? 12px : 8px;
    background: boxed ? Theme.well : transparent;
    border-width: boxed ? 1px : 0px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.7) : (boxed ? Theme.hairline : transparent);
    animate border-color { duration: Theme.motion-fast; easing: ease-out; }

    // Last focus state sent to Actions.text-focus, so each change counts once.
    property <bool> reported;
    function report(focused: bool) {
        if (focused != root.reported) {
            root.reported = focused;
            Actions.text-focus(focused);
        }
    }

    public function focus-input() {
        input.focus();
        // `changed has-focus` misses focus taken while the field is created.
        root.report(input.has-focus);
    }
    public function blur-input() {
        input.clear-focus();
    }

    // The whole box focuses the input, not just the line of text.
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: root.boxed ? 10px : 0px;
        padding-right: root.boxed ? 10px : 0px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 7px;
        if root.icon != "": IconBox {
            name: root.icon;
            size: 14px;
            tint: Theme.text-3;
        }
        text-scroll := Scroll {
            horizontal-stretch: 1;
            min-width: 0px;
            content-width: self.width;
            content-height: Math.max(self.height, input.preferred-height);
            menu-area := TouchArea {
                mouse-cursor: MouseCursor.text;
                clicked => { input.focus(); }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                        input.focus();
                        edit-menu.show();
                    }
                }
            }
            edit-menu := PopupWindow {
                x: Math.max(0px, Math.min(menu-area.mouse-x, parent.width - self.width));
                y: menu-area.mouse-y;
                width: 160px;
                height: menu-items.preferred-height;
                Rectangle {
                    background: Theme.float;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    menu-items := VerticalLayout {
                        padding: 4px;
                        Button { text: "Copy"; enabled: input.text != ""; clicked => { input.copy(); edit-menu.close(); } }
                        Button { text: "Cut"; enabled: input.text != ""; clicked => { input.cut(); edit-menu.close(); } }
                        Button { text: "Paste"; clicked => { input.paste(); edit-menu.close(); } }
                        Button { text: "Select all"; enabled: input.text != ""; clicked => { input.select-all(); edit-menu.close(); } }
                    }
                }
            }
            placeholder-text := Text {
                x: 0;
                y: root.multiline ? 0 : (parent.height - self.height) / 2;
                width: parent.width;
                text: root.placeholder;
                visible: input.text == "" && input.preedit-text == "";
                color: Theme.text-3;
                font-size: root.font-size;
                font-weight: root.font-weight;
                overflow: elide;
            }
            input := TextInput {
                x: 0;
                y: 0;
                width: parent.width;
                height: text-scroll.content-height;
                color: Theme.text;
                font-size: root.font-size;
                font-weight: root.font-weight;
                single-line: false;
                wrap: word-wrap;
                // Matches the centered placeholder; wrapped text fills the height anyway.
                vertical-alignment: root.multiline ? TextVerticalAlignment.top : TextVerticalAlignment.center;
                min-width: 0px;
                input-type: root.input-type;
                selection-background-color: Theme.accent.with-alpha(0.4);
                selection-foreground-color: Theme.text;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
                cursor-position-changed(pos) => {
                    if (text-scroll.content-height <= text-scroll.height) {
                        text-scroll.content-y = 0px;
                    } else if (pos.y + text-scroll.content-y < 0px) {
                        text-scroll.content-y = -pos.y;
                    } else if (pos.y + text-scroll.content-y > text-scroll.height - root.font-size * 1.5) {
                        text-scroll.content-y = Math.min(0px, text-scroll.height - pos.y - root.font-size * 1.5);
                    }
                }
                key-pressed(e) => {
                    if (e.text == Key.Return && !root.multiline) {
                        root.accepted(self.text);
                        return accept;
                    }
                    if (e.text == Key.Escape) {
                        self.clear-focus();
                        root.escaped();
                        return accept;
                    }
                    reject
                }
                changed has-focus => { root.report(self.has-focus); }
            }
        }
    }
}

// iOS-style switch.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.success : Theme.chip;
    animate background { duration: Theme.motion-fast; easing: ease-out; }
    knob := Rectangle {
        x: root.checked ? root.width - self.width - 2px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000040;
        animate x { duration: Theme.motion-panel; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Round completion checkbox in the list colour, like Reminders.
export component Check inherits Rectangle {
    in property <bool> checked;
    in property <color> tint: Theme.accent;
    in property <length> size: Store.mobile ? 22px : 18px;
    callback toggled();
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: checked ? 0px : 1.5px;
    border-color: ta.has-hover ? tint : tint.with-alpha(0.75);
    animate border-color { duration: Theme.motion-fast; easing: ease-out; }
    background: checked ? tint : (ta.pressed ? tint.with-alpha(0.2) : transparent);
    animate background { duration: Theme.motion-fast; easing: ease-out; }
    if root.checked: Icon {
        name: "check";
        size: root.size * 0.62;
        tint: #ffffff;
        stroke-width: 3px;
    }
    ta := TouchArea {
        clicked => { root.toggled(); }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <color> dot: transparent;
    in property <string> icon;
    callback clicked();
    height: Store.mobile ? 32px : 26px;
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.well;
    border-width: 1px;
    border-color: selected ? Theme.accent.with-alpha(0.65) : Theme.hairline;
    animate background { duration: Theme.motion-fast; easing: ease-out; }
    lay := HorizontalLayout {
        padding-left: 10px;
        padding-right: 11px;
        spacing: 6px;
        alignment: center;
        if root.dot != transparent: Rectangle {
            width: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot;
            }
        }
        if root.icon != "": IconBox {
            name: root.icon;
            size: 12px;
            tint: root.selected ? Theme.accent : Theme.text-2;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Store.mobile ? Theme.fs-m : Theme.fs-s;
            font-weight: 500;
            color: root.selected ? Theme.accent : Theme.text;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Priority marks: ! / !! / !!!
export component Priority inherits Text {
    in property <int> level;
    text: level == 3 ? "!!!" : level == 2 ? "!!" : level == 1 ? "!" : "";
    color: level == 3 ? Theme.danger : level == 2 ? Theme.warning : Theme.text-2;
    font-weight: 800;
    font-size: Theme.fs-s;
    vertical-alignment: center;
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <string> action;
    callback activated();
    visible: text != "";
    height: 36px;
    width: t.preferred-width + 32px + (action != "" ? 80px : 0px);
    border-radius: 18px;
    background: Theme.toast;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;
    if action != "": Button { x: parent.width - 76px; width: 72px; text: root.action; clicked => { root.activated(); } }
    t := Text {
        x: 16px;
        width: self.preferred-width;
        text: root.text;
        color: Theme.toast-text;
        font-size: Theme.fs-m;
        font-weight: 500;
    }
}
