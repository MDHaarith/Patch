import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Store, Actions, TaskItem } from "store.slint";
import { Glass, Field, IconButton, Segmented, Scroll, Check, Priority } from "widgets.slint";
import { TaskRow } from "rows.slint";
import { Pet } from "pet.slint";

// Collapsed overlay: Patch's pet, with today's open count.
export component Bubble inherits Rectangle {
    width: 60px;
    height: 60px;
    pet := Pet {
        size: 52px;
        count: Store.today-open;
    }
    public function hop() {
        pet.hop-once();
    }
}

// Expanded overlay: Today / Upcoming / Board with quick add. The top 52px
// are the drag handle on Android (the window is moved natively).
export component OverlayPanel inherits Rectangle {
    in property <length> radius: 24px;
    property <int> board-col: 0;
    Glass {
        width: parent.width;
        height: parent.height;
        radius: root.radius;
        // No blur in the software renderer: over other apps a see-through panel is unreadable.
        fill: Store.mobile ? Theme.float.with-alpha(1) : Theme.float;
        elevated: false;
        VerticalLayout {
            padding: 12px;
            padding-top: 8px;
            spacing: 8px;
            HorizontalLayout {
                height: 44px;
                spacing: 8px;
                Pet {
                    y: (parent.height - self.height) / 2;
                    size: 40px;
                    count: 0;
                    show-count: false;
                }
                // Grip
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text { text: Store.clock; font-size: 20px; font-weight: 700; color: Theme.text; }
                    Text { text: Store.pet-line; font-size: Theme.fs-s; color: Theme.text-2; overflow: elide; }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: "open";
                    size: 32px;
                    clicked => { Actions.open-app(""); }
                }
                // On Android the pet above the panel (or anywhere outside it) closes it.
                if !Store.mobile: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: "minus";
                    size: 32px;
                    clicked => { Actions.overlay-expand(false); }
                }
            }
            Segmented {
                items: ["Today", "Upcoming", "Board"];
                current: Store.overlay-tab;
                stretch: true;
                seg-height: 30px;
                picked(i) => { Store.overlay-tab = i; }
            }
            if Store.overlay-tab == 2: Rectangle {
                height: 30px;
                Scroll {
                    content-width: chips.preferred-width;
                    mouse-drag-pan-enabled: true;
                    chips := HorizontalLayout {
                        spacing: 6px;
                        for col[i] in Store.board: Rectangle {
                            height: 28px;
                            width: cl.preferred-width + 20px;
                            border-radius: 14px;
                            background: i == root.board-col ? Theme.accent-soft : Theme.well;
                            border-width: 1px;
                            border-color: i == root.board-col ? Theme.accent.with-alpha(0.7) : Theme.hairline;
                            cl := Text {
                                text: "\{col.name}  \{col.count}";
                                font-size: Theme.fs-s;
                                font-weight: 600;
                                color: i == root.board-col ? Theme.accent : Theme.text;
                            }
                            TouchArea { clicked => { root.board-col = i; } }
                        }
                    }
                }
            }
            items-scroll := Scroll {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: true;
                content-height: items.preferred-height;
                items := VerticalLayout {
                    width: items-scroll.width;
                    alignment: start;
                    spacing: 0px;
                    if Store.overlay-tab == 0: VerticalLayout {
                        for it in Store.today-items: TaskRow { item: it; dense: true; opened(id) => { Actions.open-app(id); } }
                        if Store.today-items.length == 0: Text {
                            height: 80px;
                            text: "Nothing left today ✓";
                            color: Theme.text-2;
                            font-size: Theme.fs-m;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if Store.overlay-tab == 1: VerticalLayout {
                        for it in Store.up-next: TaskRow { item: it; dense: true; opened(id) => { Actions.open-app(id); } }
                        if Store.up-next.length == 0: Text {
                            height: 80px;
                            text: "Nothing scheduled";
                            color: Theme.text-2;
                            font-size: Theme.fs-m;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if Store.overlay-tab == 2 && root.board-col < Store.board.length: VerticalLayout {
                        for it in Store.board[root.board-col].cards: TaskRow { item: it; dense: true; opened(id) => { Actions.open-app(id); } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                qa := Field {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    icon: "plus";
                    placeholder: Store.overlay-tab == 2 && root.board-col < Store.board.length ? "Add to \{Store.board[root.board-col].name}…" : "Add a task…";
                    accepted(t) => {
                        if (t != "") {
                            if (Store.overlay-tab == 2 && root.board-col < Store.board.length) {
                                Actions.quick-add-card(Store.board[root.board-col].id, t);
                            } else if (Store.overlay-tab == 0) {
                                Actions.quick-add-today(t);
                            } else {
                                Actions.quick-add(t);
                            }
                        }
                        self.text = "";
                    }
                }
            }
        }
    }
}

component DeskTile inherits Glass {
    x: 0px;
    y: 0px;
    width: 170px;
    height: 170px;
    radius: 22px;
    fill: Theme.float;
    sheen: false;
    TouchArea { clicked => { Actions.open-app(""); } }
    @children
}

component DeskList inherits DeskTile {
    in property <string> title;
    in property <[TaskItem]> items;
    in property <bool> upcoming: false;
    Text {
        x: 14px; y: 14px;
        width: 142px; height: 20px;
        text: root.title;
        font-size: Theme.fs-m;
        font-weight: 700;
        color: Theme.text;
    }
    for it[i] in root.items: Rectangle {
        visible: i < (root.upcoming ? 3 : 5);
        x: 14px;
        y: 40px + i * self.height;
        width: 142px;
        height: root.upcoming ? 38px : 23px;
        Rectangle {
            x: 0px;
            y: 6px;
            width: 4px; height: 4px;
            border-radius: 2px;
            background: it.color;
        }
        Text {
            x: 11px; y: 0px;
            width: 131px; height: 18px;
            text: it.title;
            font-size: Theme.fs-s;
            color: Theme.text;
            overflow: elide;
        }
        if root.upcoming: Text {
            x: 11px; y: 18px;
            width: 131px; height: 14px;
            text: it.when;
            font-size: 10px;
            color: Theme.text-2;
            overflow: elide;
        }
        TouchArea {
            enabled: i < (root.upcoming ? 3 : 5);
            clicked => { Actions.open-app(it.id); }
        }
    }
    if root.items.length == 0: Text {
        x: 14px; y: 44px;
        width: 142px; height: 100px;
        text: root.upcoming ? "Nothing scheduled" : "Nothing left today ✓";
        font-size: Theme.fs-s;
        color: Theme.text-2;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

export component DeskBoard inherits Rectangle {
    width: 352px;
    height: 352px;
    DeskTile {
        VerticalLayout {
            padding: 16px;
            spacing: 0px;
            Text {
                text: Store.today-weekday;
                font-size: Theme.fs-m;
                font-weight: 600;
                color: Theme.today;
            }
            Text {
                text: Store.today-day;
                font-size: 72px;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: Store.today-month;
                font-size: Theme.fs-l;
                font-weight: 500;
                color: Theme.text-2;
            }
        }
    }
    DeskTile {
        x: 182px;
        Text {
            x: 14px; y: 14px;
            width: 142px; height: 20px;
            text: Store.mini-title;
            font-size: Theme.fs-m;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        heads := Rectangle {
            x: 14px; y: 40px;
            width: 142px; height: 14px;
            for d[i] in Store.weekdays-short: Text {
                x: i * heads.width / 7;
                width: heads.width / 7;
                text: d;
                horizontal-alignment: center;
                font-size: 8px;
                font-weight: 600;
                color: Theme.text-2;
            }
        }
        grid := Rectangle {
            x: 14px; y: 58px;
            width: 142px; height: 96px;
            for cell[i] in Store.mini-cells: Rectangle {
                x: Math.mod(i, 7) * grid.width / 7;
                y: Math.floor(i / 7) * 16px;
                width: grid.width / 7;
                height: 16px;
                Rectangle {
                    width: 16px; height: 16px;
                    border-radius: 8px;
                    background: cell.today ? Theme.today : transparent;
                    Text {
                        text: cell.day;
                        font-size: 10px;
                        font-weight: cell.today ? 700 : 500;
                        color: cell.today ? #ffffff : cell.in-month ? Theme.text : Theme.text-3;
                    }
                }
            }
        }
    }
    DeskList {
        y: 182px;
        title: "Today";
        items: Store.today-items;
    }
    DeskList {
        x: 182px; y: 182px;
        title: "Up next";
        items: Store.up-next;
        upcoming: true;
    }
}

export component OverlayWindow inherits Window {
    in property <int> mode: 0;
    title: "Patch";
    icon: Store.app-icon;
    default-font-family: "Inter";
    background: transparent;
    no-frame: true;
    always-on-top: root.mode != 2;
    preferred-width: 340px;
    preferred-height: 500px;
    min-width: 60px;
    min-height: 60px;
    // Java sends the saved pet origin relative to the usable screen, in logical pixels.
    in property <length> pet-x: 0px;
    in property <length> pet-y: 0px;
    property <bool> panel-surface: root.width > 120px || root.height > 120px;
    property <float> reveal: Store.mobile && Store.overlay-expanded && root.panel-surface ? 1 : 0;
    animate reveal { duration: 220ms; easing: ease-out; }
    property <bool> transitioning: false;
    Timer {
        interval: 240ms;
        running: root.transitioning;
        triggered => { root.transitioning = false; }
    }
    function toggle-mobile() {
        if !root.transitioning {
            root.transitioning = true;
            Actions.overlay-expand(!Store.overlay-expanded);
        }
    }
    if root.mode != 2 && Store.mobile: mobile := Rectangle {
        // Keep the panel mounted until Java shrinks the surface after the close animation.
        Rectangle {
            visible: root.panel-surface;
            background: #000000.with-alpha(0.4 * root.reveal);
            TouchArea { clicked => { root.toggle-mobile(); } }
        }
        pet := Bubble {
            x: root.panel-surface ? clamp(root.pet-x, 0px, parent.width - self.width) : (parent.width - self.width) / 2;
            y: root.panel-surface ? clamp(root.pet-y, 0px, parent.height - self.height) : (parent.height - self.height) / 2;
            pet-touch := TouchArea { clicked => { root.toggle-mobile(); } }
        }
        property <length> below: max(0px, self.height - pet.y - pet.height - 19px);
        property <length> above: max(0px, pet.y - 19px);
        property <bool> opens-below: below >= min(540px, above);
        property <length> panel-width: max(0px, min(self.width - 16px, 480px));
        property <length> panel-height: min(540px, opens-below ? below : above);
        property <length> panel-x: clamp(pet.x + pet.width / 2 - panel-width / 2, 8px, self.width - panel-width - 8px);
        property <length> panel-y: opens-below ? pet.y + pet.height + 11px : pet.y - panel-height - 11px;
        Path {
            visible: root.panel-surface;
            opacity: root.reveal;
            x: clamp(pet.x + (pet.width - self.width) / 2, mobile.panel-x, mobile.panel-x + mobile.panel-width - self.width);
            y: mobile.opens-below ? pet.y + pet.height + 2px : pet.y - 12px;
            width: 22px;
            height: 10px;
            viewbox-width: 22;
            viewbox-height: 10;
            commands: mobile.opens-below ? "M 0 10 L 11 0 L 22 10 Z" : "M 0 0 L 11 10 L 22 0 Z";
            fill: Theme.float.with-alpha(1);
        }
        // Taps on the panel's own padding must not close it.
        TouchArea {
            visible: root.panel-surface && root.reveal > 0;
            x: popup.x; y: popup.y; width: popup.width; height: popup.height;
        }
        popup := OverlayPanel {
            visible: root.panel-surface && root.reveal > 0;
            opacity: root.reveal;
            // Both directions use the current pet rect, including screen/IME clamping.
            width: pet.width + (mobile.panel-width - pet.width) * root.reveal;
            height: pet.height + (mobile.panel-height - pet.height) * root.reveal;
            x: pet.x + (mobile.panel-x - pet.x) * root.reveal;
            y: pet.y + (mobile.panel-y - pet.y) * root.reveal;
            clip: true;
            radius: 24px;
        }
    }
    if root.mode != 2 && Store.overlay-expanded && !Store.mobile: OverlayPanel {
        width: parent.width;
        height: parent.height;
        radius: Store.mobile ? 24px : 20px;
    }
    if root.mode != 2 && !Store.overlay-expanded && !Store.mobile: bubble := Bubble {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        TouchArea {
            clicked => { Actions.overlay-expand(true); }
        }
    }
    if root.mode == 2: DeskBoard {
        width: parent.width;
        height: parent.height;
    }
}
